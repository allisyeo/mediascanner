# KT MediaScanner — Environment Variables
# Скопируй этот файл в .env и заполни значения

PORT=3000
NODE_ENV=development

# Instagram Graph API
# TODO: получить в Meta Developer Console (business/creator account)
# НЕ хранить во frontend — только на backend/сервере
INSTAGRAM_ACCESS_TOKEN=

# Telegram Bot API
# TODO: получить у @BotFather в Telegram
# НЕ хранить во frontend — только на backend/сервере
TELEGRAM_BOT_TOKEN=

# База данных (PostgreSQL — нужна на production/VPS)
# Пример: postgresql://user:password@localhost:5432/mediascanner
DATABASE_URL=

# JWT для авторизации (генерируй случайную строку длиной 64+ символа)
JWT_SECRET=
