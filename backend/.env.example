# KT MediaScanner — Environment Variables
# Скопируй этот файл в .env и заполни значения

PORT=3000
NODE_ENV=development

# ─── Авторизация ──────────────────────────────────────────────────────────────
# JWT_SECRET — ОБЯЗАТЕЛЕН в production.
# Генерация: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# В dev допустим временный fallback, но НИКОГДА не оставляй пустым на сервере.
JWT_SECRET=change_me_in_production

# Имя httpOnly cookie с JWT токеном (менять не обязательно)
AUTH_COOKIE_NAME=kt_mediascanner_auth

# Cookie secure: false — для локальной разработки (http)
#                true  — для production (https)
COOKIE_SECURE=false

# Cookie sameSite: lax — стандартное значение для SPA
COOKIE_SAME_SITE=lax

# ─── Instagram Graph API ───────────────────────────────────────────────────────
# TODO: получить в Meta Developer Console (business/creator account)
# НЕ хранить во frontend — только на backend/сервере
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_REDIRECT_URI=

# ─── Telegram Bot API ─────────────────────────────────────────────────────────
# TODO: получить у @BotFather в Telegram
# НЕ хранить во frontend — только на backend/сервере
TELEGRAM_BOT_TOKEN=

# ─── База данных ──────────────────────────────────────────────────────────────
# PostgreSQL — нужна на production/VPS (заменяет demo-данные из памяти)
# Пример: postgresql://user:password@localhost:5432/mediascanner
DATABASE_URL=
